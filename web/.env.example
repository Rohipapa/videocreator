# 이 파일을 .env.local로 복사해 값을 채우세요. .env.local은 저장소에 올리지 않습니다.

# 토스페이먼츠 개발자센터 > API 키 > "API 개별 연동 키" (결제위젯 연동 키 아님)
# https://developers.tosspayments.com/my/api-keys
# 클라이언트 키는 브라우저 SDK용이라 공개되어도 됩니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
# 시크릿 키는 서버 전용입니다. 절대 NEXT_PUBLIC_ 접두어를 붙이지 마세요.
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx

# 빌링키 암호화용 32바이트 키(base64). 생성 예:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BILLING_KEY_SECRET=

# 정기결제 cron 엔드포인트(POST /api/cron/billing) 인증용 임의 문자열
CRON_SECRET=
